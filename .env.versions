# hello-sql Docker 镜像版本入口与实测锁文件
# *_TAG 是首次手动采集的明确版本入口；工作流拉取后写入对应 *_IMAGE=tag@sha256。
# cloud/browser/restricted-image 条目不得伪造可运行镜像；禁止 latest、edge、nightly。

POSTGRESQL_TAG=postgres:18-alpine
MYSQL_TAG=mysql:8.4
MARIADB_TAG=mariadb:11.8
SQLSERVER_TAG=mcr.microsoft.com/mssql/server:2022-CU14-ubuntu-22.04
CLICKHOUSE_TAG=clickhouse/clickhouse-server:25.8
TIDB_TAG=pingcap/tidb:v8.5.0
COCKROACHDB_TAG=cockroachdb/cockroach:v25.2.0
MONGODB_TAG=mongo:8.0
COUCHDB_TAG=couchdb:3.5
REDIS_TAG=redis:8.2
VALKEY_TAG=valkey/valkey:9.0
DYNAMODB_LOCAL_TAG=amazon/dynamodb-local:2.6.0
CASSANDRA_TAG=cassandra:5.0
SCYLLADB_TAG=scylladb/scylla:2025.2
ELASTICSEARCH_TAG=docker.elastic.co/elasticsearch/elasticsearch:9.1.3
OPENSEARCH_TAG=opensearchproject/opensearch:3.2.0
NEO4J_TAG=neo4j:2025.08.0-community
INFLUXDB_TAG=influxdb:2.7
TIMESCALEDB_TAG=timescale/timescaledb:2.21.0-pg17

# 嵌入式 CLI 自建镜像的官方基础镜像。
DEBIAN_BASE_TAG=debian:bookworm-slim

# 只承担连接/HTTP 调用的客户端镜像。
CURL_CLIENT_TAG=curlimages/curl:8.15.0
AWS_CLI_TAG=amazon/aws-cli:2.27.49
MYSQL_CLIENT_TAG=mysql:8.4
GCLOUD_CLI_TAG=google/cloud-sdk:533.0.0-slim

# 以下 *_IMAGE 由 collect:docker 在成功拉取后追加/更新，不手工填写 digest。
CURL_CLIENT_IMAGE=curlimages/curl:8.15.0@sha256:4026b29997dc7c823b51c164b71e2b51e0fd95cce4601f78202c513d97da2922

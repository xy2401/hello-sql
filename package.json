{
  "name": "hello-sql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SQL、NoSQL、浏览器数据库与 WebAssembly 数据库交互学习平台",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run docs:dev",
    "build": "npm run docs:build",
    "preview": "npm run docs:preview",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:content": "node scripts/check-content.js",
    "check": "npm run check:content && npm run typecheck && npm run test && npm run docs:build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@electric-sql/pglite": "0.5.4",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@surrealdb/wasm": "3.0.3",
    "@lezer/highlight": "1.2.1",
    "surrealdb": "2.0.8",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
